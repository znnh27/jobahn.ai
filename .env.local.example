# 複製這份成 .env.local，填入你自己的 Supabase 專案資訊
# 這兩個值在 Supabase 專案的 Settings > API 頁面可以找到

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 用於後端（Server Action / Route Handler）操作 Vault、繞過 RLS 的管理權限 key
# 在 Supabase 專案的 Settings > API 頁面的 service_role key
# 絕對不能加上 NEXT_PUBLIC_ 前綴，也絕對不能暴露到瀏覽器端
SUPABASE_SERVICE_ROLE_KEY=

# 用於伺服器端呼叫 Firecrawl 抓取職缺頁面（共用你自己的帳號，不做 BYOK）
FIRECRAWL_API_KEY=

# ============================================================
# AI 呼叫設定（雙模式，見 askClaude() 共用函式）
# 使用者「不需要」自己申請 Key 就能用；BYOK（/settings 頁綁自己的 Key）是選填功能，
# 沒綁的人一律走這裡設定的共用額度。
# ============================================================

# local-cli：本機開發用，透過已登入 Pro/Max 的 Claude Code CLI（headless 模式）呼叫，
#            不需要 API Key，用你自己訂閱的額度。只能在本機 `npm run dev` 時使用，
#            部署到 Vercel 後無法使用（serverless 環境沒有持續登入的 CLI session）。
# api      ：正式部署（Vercel）用，直接打 Anthropic Messages API，需要下面的 ANTHROPIC_API_KEY。
AI_PROVIDER=local-cli

# 只有 AI_PROVIDER=api 時才需要填，這是共用額度用的 Key（你自己的），
# 沒綁定 /settings 自己 Key 的使用者，生成功能都會算在這組 Key 上
ANTHROPIC_API_KEY=

# 選填：從區網其他裝置（例如同一個 WiFi 的手機）連開發伺服器時才需要，
# 填這台電腦的區網 IP，多個用逗號分隔
DEV_ALLOWED_ORIGINS=
