# 複製這份成 .env.local，填入你自己的 Supabase 專案資訊
# URL：https://<project-id>.supabase.co（Supabase 後台 Integrations > Data API 也看得到）
# ANON_KEY：Project Settings > API Keys 的 Publishable key（sb_publishable_...），舊專案叫 anon key，兩種都能用

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 用於後端（Server Action / Route Handler）操作 Vault、繞過 RLS 的管理權限 key
# Project Settings > API Keys 的 Secret key（sb_secret_...），舊專案叫 service_role key，兩種都能用
# 絕對不能加上 NEXT_PUBLIC_ 前綴，也絕對不能暴露到瀏覽器端
SUPABASE_SERVICE_ROLE_KEY=

# 選填：Firecrawl API Key。貼職缺網址自動抓 JD、寫求職信前研究公司會用到；沒填的話這兩個選項不會出現
FIRECRAWL_API_KEY=

# ============================================================
# AI 呼叫設定（雙模式，見 askClaude() 共用函式）
# 二選一。/settings 頁可以另外綁自己的 Anthropic Key（選填），沒綁的話一律用這裡的設定。
# ============================================================

# local-cli：本機開發用，透過已登入 Pro/Max 的 Claude Code CLI（headless 模式）呼叫，
#            不需要 API Key，用你自己訂閱的額度。只能在本機 `npm run dev` 時使用，
#            部署到伺服器後無法使用（伺服器上沒有登入的 CLI session）。請自行確認你的方案條款允許這種用法。
# api      ：直接打 Anthropic Messages API，需要下面的 ANTHROPIC_API_KEY；部署到伺服器時用這個。
AI_PROVIDER=local-cli

# 只有 AI_PROVIDER=api 時才需要填
ANTHROPIC_API_KEY=

# 選填：從區網其他裝置（例如同一個 WiFi 的手機）連開發伺服器時才需要，
# 填這台電腦的區網 IP，多個用逗號分隔
DEV_ALLOWED_ORIGINS=
